{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AzureSQL": "Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<db>;Persist Security Info=False;User ID=<user>;Password=<password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "AllowedHosts": "*",
  "AzureStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net",
    "Queues": {
      "OrderQueue": "ordermsg",
      "InventoryQueue": "inventory-msg",
      "MessageRetryCount": 3,
      "MessageTimeoutSeconds": 30
    }
  },
  "AzureFunctions": {
    "BaseUrl": "https://<functionapp>.azurewebsites.net/api",
    "FunctionKey": "<function-key>",
    "ProcessCompleteOrderUrl": "https://<functionapp>.azurewebsites.net/api/orders/process",
    "QueueOrderMessageUrl": "https://<functionapp>.azurewebsites.net/api/orders/queue",
    "QueueInventoryMessageUrl": "https://<functionapp>.azurewebsites.net/api/inventory/queue",
    "GetQueueStatusUrl": "https://<functionapp>.azurewebsites.net/api/orders/queues/status"
  }
}
