@model ST10439147_CLDV6212_POE.Models.Product

@{
    ViewData["Title"] = "Delete Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="card-title mb-0">
                        <i class="fas fa-trash-alt"></i> Delete Product
                    </h2>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle"></i> @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Warning Message -->
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Warning!</strong> Are you sure you want to delete this product? This action cannot be undone.
                    </div>

                    <!-- Product Details Display -->
                    <div class="row">
                        <div class="col-md-4 text-center">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" alt="@Model.Name"
                                     class="img-fluid img-thumbnail mb-3"
                                     style="max-width: 200px; max-height: 200px;" />
                            }
                            else
                            {
                                <div class="bg-light p-4 mb-3 text-center img-thumbnail"
                                     style="width: 200px; height: 200px; display: flex; align-items: center; justify-content: center;">
                                    <div class="text-muted">
                                        <i class="fas fa-image fa-3x"></i>
                                        <br />
                                        <small>No Image</small>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="col-md-8">
                            <table class="table table-borderless">
                                <tbody>
                                    <tr>
                                        <td class="fw-bold text-muted">
                                            <i class="fas fa-tag"></i> Product Name:
                                        </td>
                                        <td>@Html.DisplayFor(model => model.Name)</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted">
                                            <i class="fas fa-align-left"></i> Description:
                                        </td>
                                        <td>
                                            @if (string.IsNullOrEmpty(Model.Description))
                                            {
                                                <em class="text-muted">No description provided</em>
                                            }
                                            else
                                            {
                                                @Html.DisplayFor(model => model.Description)
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted">
                                            <i class="fas fa-dollar-sign"></i> Price:
                                        </td>
                                        <td>
                                            <span class="fs-5 text-success fw-bold">
                                                R @Html.DisplayFor(model => model.Price)
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted">
                                            <i class="fas fa-boxes"></i> Stock Quantity:
                                        </td>
                                        <td>
                                            <span class="badge @(Model.StockQuantity > 0 ? "bg-success" : "bg-danger")">
                                                @Html.DisplayFor(model => model.StockQuantity) units
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted">
                                            <i class="fas fa-key"></i> Product ID:
                                        </td>
                                        <td>
                                            <small class="text-muted font-monospace">@Html.DisplayFor(model => model.RowKey)</small>
                                        </td>
                                    </tr>
                                    @if (Model.Timestamp.HasValue)
                                    {
                                        <tr>
                                            <td class="fw-bold text-muted">
                                                <i class="fas fa-calendar-alt"></i> Created:
                                            </td>
                                            <td>
                                                <small class="text-muted">@Model.Timestamp.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <form asp-action="Delete" method="post" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="RowKey" />
                                <input type="hidden" asp-for="PartitionKey" />

                                <button type="button" class="btn btn-danger me-2" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                                    <i class="fas fa-trash-alt"></i> Yes, Delete Product
                                </button>

                                <!-- Confirmation Modal -->
                                <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title" id="confirmDeleteModalLabel">
                                                    <i class="fas fa-exclamation-triangle"></i> Confirm Deletion
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-3">
                                                    <strong>Are you absolutely sure you want to delete "@Model.Name"?</strong>
                                                </p>
                                                <p class="text-muted mb-0">
                                                    <i class="fas fa-info-circle"></i>
                                                    This action will:
                                                </p>
                                                <ul class="text-muted mt-2">
                                                    <li>Permanently remove the product from your inventory</li>
                                                    <li>Delete the associated product image</li>
                                                    <li>Cannot be undone</li>
                                                </ul>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    <i class="fas fa-times"></i> Cancel
                                                </button>
                                                <button type="submit" class="btn btn-danger">
                                                    <i class="fas fa-trash-alt"></i> Yes, Delete Forever
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>

                            <a asp-action="Edit" asp-route-id="@Model.RowKey" class="btn btn-warning me-2">
                                <i class="fas fa-edit"></i> Edit Instead
                            </a>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to Products
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-focus on the delete button when modal opens
        document.getElementById('confirmDeleteModal').addEventListener('shown.bs.modal', function () {
            this.querySelector('.btn-danger[type="submit"]').focus();
        });

        // Add keyboard shortcut for quick actions
        document.addEventListener('keydown', function(e) {
            // ESC key to go back
            if (e.key === 'Escape') {
                window.location.href = '@Url.Action("Index")';
            }

            // Ctrl+E to edit
            if (e.ctrlKey && e.key === 'e') {
                e.preventDefault();
                window.location.href = '@Url.Action("Edit", new { id = Model.RowKey })';
            }
        });

        // Add confirmation when leaving page if modal was opened
        let modalOpened = false;
        document.getElementById('confirmDeleteModal').addEventListener('shown.bs.modal', function () {
            modalOpened = true;
        });

        // Smooth scroll to top on page load
        window.addEventListener('load', function() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });
    </script>
}