@model ST10439147_CLDV6212_POE.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register - ABC Retail";
}

<div class="register-container">
    <div class="container-fluid">
        <div class="row min-vh-100">
            <!-- Left Side - Branding/Info -->
            <div class="col-lg-6 d-none d-lg-flex register-info-side">
                <div class="d-flex flex-column justify-content-center align-items-center text-white p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-user-plus display-1 mb-4"></i>
                        <h2 class="mb-3">Join ABC Retail</h2>
                        <p class="lead mb-4">Create your account and start your seamless shopping journey today</p>
                    </div>

                    <div class="features-list text-start">
                        <div class="feature-item mb-3">
                            <i class="fas fa-check-circle me-3"></i>
                            <span>Quick and easy registration</span>
                        </div>
                        <div class="feature-item mb-3">
                            <i class="fas fa-check-circle me-3"></i>
                            <span>Secure account protection</span>
                        </div>
                        <div class="feature-item mb-3">
                            <i class="fas fa-check-circle me-3"></i>
                            <span>Personalized recommendations</span>
                        </div>
                        <div class="feature-item mb-3">
                            <i class="fas fa-check-circle me-3"></i>
                            <span>Order tracking & history</span>
                        </div>
                        <div class="feature-item mb-3">
                            <i class="fas fa-check-circle me-3"></i>
                            <span>Exclusive member benefits</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side - Registration Form -->
            <div class="col-lg-6 d-flex align-items-center justify-content-center">
                <div class="register-form-container p-4">
                    <div class="text-center mb-4">
                        <div class="d-lg-none mb-3">
                            <i class="fas fa-user-plus text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h3 class="mb-2">Create Your Account</h3>
                        <p class="text-muted">Join thousands of satisfied customers</p>
                    </div>

                    <form asp-action="Register" asp-controller="Account" method="post" class="register-form">
                        @Html.AntiForgeryToken()

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label">First Name</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input asp-for="FirstName" class="form-control" placeholder="John" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label">Last Name</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input asp-for="LastName" class="form-control" placeholder="Doe" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-envelope"></i>
                                </span>
                                <input asp-for="Email" class="form-control" placeholder="john.doe@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Phone Number <span class="text-muted">(Optional)</span></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-phone"></i>
                                </span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="+27 12 345 6789" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input asp-for="Password" type="password" class="form-control" id="passwordInput" placeholder="At least 6 characters" />
                                <button class="btn btn-outline-secondary toggle-password" type="button" data-target="passwordInput">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <small class="form-text text-muted">Password must be at least 6 characters long</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPasswordInput" placeholder="Re-enter your password" />
                                <button class="btn btn-outline-secondary toggle-password" type="button" data-target="confirmPasswordInput">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        @if (ViewData.ModelState.ErrorCount > 0 && !ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                            </div>
                        }

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-user-plus me-2"></i>
                                Create Account
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <p class="text-muted small">
                            Already have an account?
                            <a asp-action="Login" asp-controller="Account" class="text-decoration-none">
                                <strong>Sign in here</strong>
                            </a>
                        </p>
                        <p class="text-muted small mt-2">
                            By registering, you agree to our
                            <a asp-action="Privacy" asp-controller="Home" class="text-decoration-none">
                                <strong>Terms & Privacy Policy</strong>
                            </a>
                        </p>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>
                            Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Toggle password visibility
        document.addEventListener('DOMContentLoaded', function() {
            const toggleButtons = document.querySelectorAll('.toggle-password');

            toggleButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const targetId = this.getAttribute('data-target');
                    const passwordInput = document.getElementById(targetId);

                    if (passwordInput) {
                        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                        passwordInput.setAttribute('type', type);

                        const icon = this.querySelector('i');
                        icon.classList.toggle('fa-eye');
                        icon.classList.toggle('fa-eye-slash');
                    }
                });
            });

            // Real-time password match validation
            const password = document.getElementById('passwordInput');
            const confirmPassword = document.getElementById('confirmPasswordInput');

            if (password && confirmPassword) {
                confirmPassword.addEventListener('input', function() {
                    if (password.value !== confirmPassword.value) {
                        confirmPassword.setCustomValidity('Passwords do not match');
                    } else {
                        confirmPassword.setCustomValidity('');
                    }
                });
            }
        });
    </script>
}

<style>
    .register-info-side {
        background: linear-gradient(135deg, darkgreen 0%, black 100%);
    }

    .register-form-container {
        max-width: 500px;
        width: 100%;
    }

    .feature-item {
        font-size: 1rem;
        display: flex;
        align-items: center;
    }

        .feature-item i {
            color: #90EE90;
            font-size: 1.2rem;
        }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
    }

    .input-group input {
        border-left: none;
    }

        .input-group input:focus {
            border-color: #ced4da;
            box-shadow: none;
        }

            .input-group input:focus + .input-group-text,
            .input-group-text + input:focus {
                border-color: #28a745;
            }

    .btn-primary {
        background: linear-gradient(135deg, darkgreen 0%, #006400 100%);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #006400 0%, darkgreen 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0,100,0,0.3);
        }

    .btn-outline-secondary {
        border-color: #6c757d;
        color: #6c757d;
        transition: all 0.3s ease;
    }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            color: white;
        }

    .toggle-password {
        cursor: pointer;
        border-left: none;
    }

    .alert {
        border-radius: 8px;
    }

    a.text-decoration-none {
        color: darkgreen;
        font-weight: 500;
    }

        a.text-decoration-none:hover {
            color: #006400;
            text-decoration: underline !important;
        }

    .form-text {
        font-size: 0.875rem;
    }
</style>