@model ST10439147_CLDV6212_POE.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-user-times me-2"></i>Delete Customer
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Warning Alert -->
                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <i class="fas fa-exclamation-triangle me-3 fs-4"></i>
                        <div>
                            <strong>Warning!</strong> You are about to permanently delete this customer. This action cannot be undone.
                        </div>
                    </div>

                    <!-- Customer Information Display -->
                    <div class="customer-details bg-light p-4 rounded mb-4">
                        <h5 class="text-primary mb-3">
                            <i class="fas fa-user-circle me-2"></i>Customer Information
                        </h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-item mb-3">
                                    <label class="fw-bold text-muted d-block">
                                        <i class="fas fa-id-card me-1"></i>Customer ID
                                    </label>
                                    <span class="fs-6">@Model.RowKey</span>
                                </div>
                                <div class="detail-item mb-3">
                                    <label class="fw-bold text-muted d-block">
                                        <i class="fas fa-user me-1"></i>First Name
                                    </label>
                                    <span class="fs-6">@Model.FirstName</span>
                                </div>
                                <div class="detail-item mb-3">
                                    <label class="fw-bold text-muted d-block">
                                        <i class="fas fa-user me-1"></i>Last Name
                                    </label>
                                    <span class="fs-6">@Model.LastName</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-item mb-3">
                                    <label class="fw-bold text-muted d-block">
                                        <i class="fas fa-envelope me-1"></i>Email Address
                                    </label>
                                    <span class="fs-6">@Model.Email</span>
                                </div>
                                <div class="detail-item mb-3">
                                    <label class="fw-bold text-muted d-block">
                                        <i class="fas fa-phone me-1"></i>Phone Number
                                    </label>
                                    <span class="fs-6">@Model.PhoneNumber</span>
                                </div>
                                @if (Model.Timestamp.HasValue)
                                {
                                    <div class="detail-item mb-3">
                                        <label class="fw-bold text-muted d-block">
                                            <i class="fas fa-clock me-1"></i>Last Modified
                                        </label>
                                        <span class="fs-6">@Model.Timestamp?.ToString("MMM dd, yyyy 'at' h:mm tt")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Confirmation Form -->
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-action="Index" class="btn btn-secondary me-2">
                                <i class="fas fa-arrow-left me-2"></i>Back to List
                            </a>
                            <a asp-action="Details" asp-route-partitionKey="@Model.PartitionKey" asp-route-rowKey="@Model.RowKey"
                               class="btn btn-info">
                                <i class="fas fa-eye me-2"></i>View Details
                            </a>
                        </div>

                        <form asp-action="Delete" method="post" class="d-inline"
                              onsubmit="return confirm('Are you absolutely sure you want to delete this customer? This action cannot be undone.');">
                            @Html.HiddenFor(model => model.PartitionKey)
                            @Html.HiddenFor(model => model.RowKey)

                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash-alt me-2"></i>Yes, Delete Customer
                            </button>
                        </form>
                    </div>

                    <!-- Additional confirmation text -->
                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            By clicking "Yes, Delete Customer", you confirm that you want to permanently remove
                            <strong>@Model.FirstName @Model.LastName</strong> from the system.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-item label {
        font-size: 0.9em;
        margin-bottom: 2px;
    }

    .detail-item span {
        color: #333;
        font-weight: 500;
    }

    .customer-details {
        border-left: 4px solid #dc3545;
    }
</style>