@model List<ST10439147_CLDV6212_POE.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Customer Management</h2>
        <!--<a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Customer
        </a>-->
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3"><i class="bi bi-search"></i> Search Customers</h5>
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-primary text-white">
                            <i class="bi bi-person-search"></i>
                        </span>
                        <input type="text"
                               class="form-control"
                               name="searchName"
                               id="searchName"
                               placeholder="Search by first name, last name, or full name..."
                               value="@ViewBag.SearchName"
                               autocomplete="off">
                        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchName))
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    onclick="clearSearch()"
                                    title="Clear search">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        }
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
            @if (!string.IsNullOrWhiteSpace(ViewBag.SearchName))
            {
                <div class="mt-3 p-2 bg-light rounded">
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i>
                        <strong>@ViewBag.ResultCount</strong> customer(s) found matching "<strong>@ViewBag.SearchName</strong>"
                    </small>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-2">
                        <i class="bi bi-arrow-counterclockwise"></i> Show All
                    </a>
                </div>
            }
            else
            {
                <div class="mt-2">
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i> Showing all customers
                    </small>
                </div>
            }
        </div>
    </div>

    <!-- Customer Table -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th><i class="bi bi-person"></i> First Name</th>
                                <th><i class="bi bi-person"></i> Last Name</th>
                                <th><i class="bi bi-envelope"></i> Email</th>
                                <th><i class="bi bi-telephone"></i> Phone Number</th>
                                <th class="text-center"><i class="bi bi-gear"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                <tr>
                                    <td>@customer.FirstName</td>
                                    <td>@customer.LastName</td>
                                    <td>@customer.Email</td>
                                    <td>@(customer.PhoneNumber ?? "N/A")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <!-- <a asp-action="Edit"
                                               asp-route-partitionKey="@customer.PartitionKey"
                                               asp-route-rowKey="@customer.RowKey"
                                               class="btn btn-sm btn-warning"
                                               title="Edit customer">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>-->
                                            <a asp-action="Delete"
                                               asp-route-partitionKey="@customer.PartitionKey"
                                               asp-route-rowKey="@customer.RowKey"
                                               class="btn btn-sm btn-danger"
                                               title="Delete customer">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3 text-muted">
                    <small>Total: <strong>@Model.Count</strong> customer(s)</small>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                @if (!string.IsNullOrWhiteSpace(ViewBag.SearchName))
                {
                    <i class="bi bi-search display-1 text-muted"></i>
                    <h4 class="mt-3">No Results Found</h4>
                    <p class="text-muted">
                        No customers found matching "<strong>@ViewBag.SearchName</strong>".
                        <br>Try a different search term or <a asp-action="Index">view all customers</a>.
                    </p>
                }
                else
                {
                    <i class="bi bi-people display-1 text-muted"></i>
                    <h4 class="mt-3">No Customers Yet</h4>
                    <p class="text-muted">Get started by adding your first customer.</p>
                    <a asp-action="Create" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Add New Customer
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);

        // Clear search function
        function clearSearch() {
            document.getElementById('searchName').value = '';
            document.querySelector('form').submit();
        }

        // Focus on search input when page loads if there's no search term
        document.addEventListener('DOMContentLoaded', function() {
            var searchInput = document.getElementById('searchName');
            if (searchInput && !searchInput.value) {
                searchInput.focus();
            }
        });

        // Add search on Enter key
        document.getElementById('searchName').addEventListener('keypress', function(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                this.form.submit();
            }
        });
    </script>
}

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
        cursor: pointer;
    }

    .btn-group .btn {
        margin: 0 2px;
    }

    .card {
        border: none;
    }

    .card-title {
        color: #0d6efd;
        font-weight: 600;
    }
</style>