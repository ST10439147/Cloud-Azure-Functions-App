@model ST10439147_CLDV6212_POE.Models.Order
@{
    ViewData["Title"] = "Edit Order";
    var products = ViewBag.Products as List<ST10439147_CLDV6212_POE.Models.Product>;
    var currentProduct = products?.FirstOrDefault(p => p.RowKey == Model.ProductId);
}

<link rel="stylesheet" href="~/css/customer-edit.css" />

<div class="edit-order-container">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a asp-action="MyOrders" class="breadcrumb-link">
            <span>← My Orders</span>
        </a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">Edit Order</span>
    </nav>

    <!-- Page Header with Order Status -->
    <div class="page-header">
        <div class="header-content">
            <div class="header-left">
                <h1 class="page-title">
                    <span class="title-icon">✏️</span>
                    <span>Edit Order</span>
                </h1>
                <p class="page-subtitle">
                    <span class="order-id-label">Order ID:</span>
                    <code class="order-id-value">@Model.RowKey</code>
                </p>
            </div>
            <div class="header-right">
                <span class="status-badge status-@Model.Status.ToLower()">
                    @if (Model.Status == "Pending")
                    {
                        <span>⏳</span>
                    }
                    else if (Model.Status == "Processing")
                    {
                        <span>⚙️</span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <span>✅</span>
                    }
                    else
                    {
                        <span>📦</span>
                    }
                    <span>@Model.Status</span>
                </span>
                <div class="order-date">
                    <span class="date-icon">📅</span>
                    <span>@Model.OrderDate.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fade-in">
            <span class="alert-icon">❌</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger fade-in">
            <span class="alert-icon">⚠️</span>
            <div>
                <strong>Please correct the following errors:</strong>
                <ul class="error-list">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    }

    <form asp-action="Edit" method="post" id="editOrderForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PartitionKey" />
        <input type="hidden" asp-for="RowKey" />
        <input type="hidden" asp-for="CustomerId" />
        <input type="hidden" asp-for="ProductId" />
        <input type="hidden" asp-for="OrderDate" />
        <input type="hidden" asp-for="Status" />
        <input type="hidden" asp-for="TotalPrice" id="hiddenTotalPrice" />

        <div class="edit-grid">
            <!-- Left Column: Product Information -->
            <div class="left-column">
                <div class="edit-card product-card">
                    <div class="card-header">
                        <h3>
                            <span class="header-icon">📦</span>
                            <span>Product Details</span>
                        </h3>
                    </div>
                    <div class="card-body">
                        @if (currentProduct != null)
                        {
                            <div class="product-display">
                                <div class="product-image-wrapper">
                                    @if (!string.IsNullOrEmpty(currentProduct.ImageUrl))
                                    {
                                        <img src="@currentProduct.ImageUrl"
                                             alt="@currentProduct.Name"
                                             class="product-image"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="product-image-placeholder">
                                            <span class="placeholder-icon">📷</span>
                                            <span class="placeholder-text">No Image</span>
                                        </div>
                                    }
                                    <div class="locked-overlay">
                                        <span class="locked-icon">🔒</span>
                                    </div>
                                </div>

                                <div class="product-info">
                                    <div class="product-header">
                                        <h3 class="product-name">@currentProduct.Name</h3>
                                        <span class="locked-badge" title="Product cannot be changed">
                                            <span>🔒</span>
                                            <span>Locked</span>
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(currentProduct.Description))
                                    {
                                        <p class="product-description">@currentProduct.Description</p>
                                    }

                                    <div class="product-meta">
                                        <div class="meta-item price-item">
                                            <span class="meta-icon">💰</span>
                                            <div class="meta-content">
                                                <span class="meta-value">@currentProduct.Price.ToString("C")</span>
                                                <span class="meta-label">per unit</span>
                                            </div>
                                        </div>
                                        <div class="meta-item stock-item">
                                            <span class="meta-icon">📊</span>
                                            <div class="meta-content">
                                                <span class="meta-value stock-badge @(currentProduct.StockQuantity < 10 ? "stock-low" : "")">
                                                    @currentProduct.StockQuantity
                                                </span>
                                                <span class="meta-label">in stock</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="info-banner">
                                        <span class="banner-icon">ℹ️</span>
                                        <span>The product is locked and cannot be changed. Only quantity can be adjusted.</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger">
                                <span class="alert-icon">⚠️</span>
                                <span>Product information not available.</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Quantity & Price -->
            <div class="right-column">
                <!-- Quantity Editor -->
                <div class="edit-card quantity-card">
                    <div class="card-header">
                        <h3>
                            <span class="header-icon">🔢</span>
                            <span>Adjust Quantity</span>
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">
                                <span class="label-text">Quantity</span>
                                <span class="label-hint">
                                    (@(currentProduct?.StockQuantity ?? 0) available)
                                </span>
                            </label>

                            <div class="quantity-input-wrapper">
                                <input type="number"
                                       asp-for="Quantity"
                                       class="form-control quantity-input-simple"
                                       id="quantityInput"
                                       min="1"
                                       max="@(currentProduct?.StockQuantity ?? 1)"
                                       required
                                       aria-label="Order quantity" />
                            </div>

                            <span asp-validation-for="Quantity" class="validation-message"></span>

                            <!-- Stock Warning -->
                            @if (currentProduct != null && currentProduct.StockQuantity < 10)
                            {
                                <div class="stock-warning">
                                    <span class="warning-icon">⚠️</span>
                                    <span>Limited stock available!</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Price Summary -->
                <div class="edit-card price-card">
                    <div class="card-header">
                        <h3>
                            <span class="header-icon">💵</span>
                            <span>Order Summary</span>
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="price-summary">
                            <div class="price-row">
                                <span class="price-label">Unit Price:</span>
                                <span class="price-value" id="unitPrice">
                                    @(currentProduct?.Price.ToString("C") ?? "$0.00")
                                </span>
                            </div>
                            <div class="price-row">
                                <span class="price-label">Quantity:</span>
                                <span class="price-value quantity-display">
                                    <span id="displayQuantity">@Model.Quantity</span>
                                    <span class="quantity-unit">items</span>
                                </span>
                            </div>
                            <div class="price-divider"></div>
                            <div class="price-row total-row">
                                <span class="price-label">Total:</span>
                                <span class="price-value total-price" id="displayTotalPrice">
                                    @Model.TotalPrice.ToString("C")
                                </span>
                            </div>

                            <!-- Savings indicator -->
                            <div class="savings-info" id="savingsInfo" style="display: none;">
                                <span class="savings-icon">💡</span>
                                <span class="savings-text">
                                    <span id="savingsAmount"></span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="button-group">
                    <button type="submit" class="btn-primary" id="saveButton">
                        <span class="btn-icon">💾</span>
                        <span class="btn-text">Save Changes</span>
                    </button>
                    <a asp-action="MyOrders" class="btn-secondary">
                        <span class="btn-icon">↩️</span>
                        <span class="btn-text">Cancel</span>
                    </a>
                </div>

                <!-- Help Text -->
                <div class="help-text">
                    <span class="help-icon">💡</span>
                    <span>Changes will update your order total and adjust inventory accordingly.</span>
                </div>
            </div>
        </div>
    </form>
</div>

