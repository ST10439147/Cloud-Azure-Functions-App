    }

    <script>
        const unitPrice = @(currentProduct?.Price ?? 0);
        const maxStock = @(currentProduct?.StockQuantity ?? 1);
        const originalQuantity = @Model.Quantity;
        const originalTotalPrice = @Model.TotalPrice;

        const quantityInput = document.getElementById('quantityInput');
        const displayQuantity = document.getElementById('displayQuantity');
        const displayTotalPrice = document.getElementById('displayTotalPrice');
        const hiddenTotalPrice = document.getElementById('hiddenTotalPrice');
        const savingsInfo = document.getElementById('savingsInfo');
        const savingsAmount = document.getElementById('savingsAmount');
        const saveButton = document.getElementById('saveButton');

        function updatePrice() {
            let quantity = parseInt(quantityInput.value);

            // Ensure quantity is valid
            if (isNaN(quantity) || quantity < 1) {
                quantity = 1;
                quantityInput.value = 1;
            }
            if (quantity > maxStock) {
                quantity = maxStock;
                quantityInput.value = maxStock;
            }

            const total = quantity * unitPrice;

            // Update display elements with animation
            displayQuantity.textContent = quantity;
            displayTotalPrice.style.transform = 'scale(1.1)';
            displayTotalPrice.textContent = total.toLocaleString('en-US', {
                style: 'currency',
                currency: 'USD'
            });

            setTimeout(() => {
                displayTotalPrice.style.transform = 'scale(1)';
            }, 200);

            // Format to 2 decimal places for form submission
            hiddenTotalPrice.value = total.toFixed(2);

            // Show savings/difference indicator
            const priceDifference = total - originalTotalPrice;
            if (Math.abs(priceDifference) > 0.01) {
                savingsInfo.style.display = 'flex';
                const savingsText = savingsInfo.querySelector('.savings-text');

                if (priceDifference > 0) {
                    savingsAmount.textContent = priceDifference.toLocaleString('en-US', {
                        style: 'currency',
                        currency: 'USD'
                    });
                    savingsText.textContent = savingsAmount.textContent + ' more than original order';
                } else {
                    savingsAmount.textContent = Math.abs(priceDifference).toLocaleString('en-US', {
                        style: 'currency',
                        currency: 'USD'
                    });
                    savingsText.textContent = savingsAmount.textContent + ' less than original order';
                }

                // Update save button to show changes pending
                if (quantity !== originalQuantity) {
                    saveButton.classList.add('btn-changes-pending');
                } else {
                    saveButton.classList.remove('btn-changes-pending');
                }
            } else {
                savingsInfo.style.display = 'none';
                saveButton.classList.remove('btn-changes-pending');
            }

            console.log('Price Updated:', {
                quantity: quantity,
                unitPrice: unitPrice,
                total: total,
                hiddenValue: hiddenTotalPrice.value
            });
        }

        // Event listeners for quantity input
        quantityInput.addEventListener('input', function() {
            updatePrice();
        });

        quantityInput.addEventListener('change', function() {
            updatePrice();
        });

        quantityInput.addEventListener('blur', function() {
            updatePrice();
        });

        // Prevent decimal input and other invalid characters
        quantityInput.addEventListener('keypress', function(e) {
            const char = e.key;
            // Only allow numbers
            if (!/[0-9]/.test(char)) {
                e.preventDefault();
            }
        });

        // Handle paste events to prevent invalid input
        quantityInput.addEventListener('paste', function(e) {
            e.preventDefault();
            const pasteData = e.clipboardData.getData('text');
            const numericValue = parseInt(pasteData);
            if (!isNaN(numericValue) && numericValue > 0) {
                quantityInput.value = Math.min(numericValue, maxStock);
                updatePrice();
            }
        });

        // Initialize price on page load
        updatePrice();

        // Confirm before leaving if changes made
        let hasUnsavedChanges = false;

        window.addEventListener('beforeunload', function(e) {
            const currentQuantity = parseInt(quantityInput.value);
            const currentTotalPrice = parseFloat(hiddenTotalPrice.value);

            if (currentQuantity !== originalQuantity || Math.abs(currentTotalPrice - originalTotalPrice) > 0.01) {
                hasUnsavedChanges = true;
                e.preventDefault();
                e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
                return e.returnValue;
            }
        });

        // Track changes for visual feedback
        quantityInput.addEventListener('input', function() {
            const currentQuantity = parseInt(this.value);
            if (currentQuantity !== originalQuantity) {
                hasUnsavedChanges = true;
            } else {
                hasUnsavedChanges = false;
            }
        });

        // Form submission handling
        const form = document.getElementById('editOrderForm');
        form.addEventListener('submit', function(e) {
            // Final update before submit
            updatePrice();

            // Validate one more time before submit
            const quantity = parseInt(quantityInput.value);
            if (isNaN(quantity) || quantity < 1) {
                e.preventDefault();
                alert('⚠️ Please enter a valid quantity (minimum 1).');
                quantityInput.focus();
                return false;
            }
            if (quantity > maxStock) {
                e.preventDefault();
                alert(`⚠️ Only ${maxStock} items available in stock.`);
                quantityInput.value = maxStock;
                updatePrice();
                quantityInput.focus();
                return false;
            }

            // Show loading state on save button
            saveButton.disabled = true;
            saveButton.innerHTML = '<span class="btn-icon">⏳</span><span class="btn-text">Saving...</span>';
            saveButton.style.opacity = '0.7';

            console.log('Form submitting with:', {
                quantity: quantity,
                totalPrice: hiddenTotalPrice.value
            });

            // Remove the beforeunload listener
            window.onbeforeunload = null;
            hasUnsavedChanges = false;
        });
    </script>
}