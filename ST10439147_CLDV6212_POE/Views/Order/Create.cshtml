@model ST10439147_CLDV6212_POE.Models.Order

@{
    ViewData["Title"] = "Create New Order";
    var products = ViewBag.Products as List<ST10439147_CLDV6212_POE.Models.Product>;
}

<style>
    .order-create-container {
        max-width: 1400px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .page-header {
        text-align: center;
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 3px solid #667eea;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
    }

    .page-subtitle {
        font-size: 1.1rem;
        color: #6c757d;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
        margin-top: 30px;
    }

    .product-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }

    .product-image-wrapper {
        position: relative;
        width: 100%;
        height: 220px;
        background: #f8f9fa;
        overflow: hidden;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.1);
    }

    .stock-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
    }

    .in-stock {
        background: #d1e7dd;
        color: #0f5132;
    }

    .out-of-stock {
        background: #f8d7da;
        color: #842029;
    }

    .product-details {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .product-name {
        font-size: 1.3rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 10px;
    }

    .product-description {
        color: #6c757d;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 15px;
        flex-grow: 1;
    }

    .product-price {
        font-size: 1.5rem;
        font-weight: 700;
        color: #e74c3c;
        margin-bottom: 10px;
    }

    .stock-info {
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 15px;
    }

    .quantity-section {
        border-top: 1px solid #e9ecef;
        padding: 20px;
        background: #f8f9fa;
    }

    .quantity-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 10px;
        display: block;
    }

    .quantity-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 15px;
    }

    .qty-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        font-size: 1.2rem;
        cursor: pointer;
        transition: transform 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .qty-btn:hover:not(:disabled) {
            transform: scale(1.1);
        }

        .qty-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .qty-input {
        flex: 1;
        text-align: center;
        font-size: 1.2rem;
        font-weight: 600;
        padding: 10px;
        border: 2px solid #e9ecef;
        border-radius: 10px;
        background: white;
    }

    .btn-add-order {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .btn-add-order.active {
            background: linear-gradient(135deg, #51cf66 0%, #37b24d 100%);
            color: white;
        }

            .btn-add-order.active:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(81, 207, 102, 0.4);
            }

        .btn-add-order.disabled {
            background: #6c757d;
            color: white;
            cursor: not-allowed;
        }

    .total-display {
        font-size: 0.9rem;
        color: #495057;
        margin-top: 10px;
        text-align: center;
    }

    .total-amount {
        font-weight: 700;
        color: #e74c3c;
        font-size: 1.1rem;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .empty-icon {
        font-size: 5rem;
        color: #cbd5e0;
        margin-bottom: 20px;
    }

    .back-button {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 12px 30px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: 600;
        display: inline-block;
        transition: transform 0.2s ease;
        margin-bottom: 30px;
    }

        .back-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            color: white;
        }
</style>

<div class="order-create-container">
    <div class="text-center mb-4">
        <a asp-action="MyOrders" class="back-button">
            ← Back to My Orders
        </a>
    </div>

    <div class="page-header">
        <h1 class="page-title">🛒 Create New Order</h1>
        <p class="page-subtitle">Select a product and quantity to place your order</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (products != null && products.Any())
    {
        <div class="product-grid">
            @foreach (var product in products.Where(p => p.StockQuantity > 0))
            {
                <div class="product-card">
                    <div class="product-image-wrapper">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" class="product-image" />
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/280x220?text=No+Image" alt="@product.Name" class="product-image" />
                        }
                        <span class="stock-badge in-stock">In Stock</span>
                    </div>

                    <div class="product-details">
                        <h3 class="product-name">@product.Name</h3>
                        <p class="product-description">@product.Description</p>
                        <div class="product-price">@product.Price.ToString("C")</div>
                        <div class="stock-info">Available: @product.StockQuantity units</div>
                    </div>

                    <form asp-action="Create" method="post" class="quantity-section">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProductId" value="@product.RowKey" />

                        @* Changed from hidden to text input with display:none to ensure value is submitted *@
                        <input type="text"
                               name="TotalPrice"
                               class="total-price-input"
                               value="@product.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                               style="display: none;"
                               readonly />

                        <label class="quantity-label">Quantity:</label>
                        <div class="quantity-controls">
                            <button type="button" class="qty-btn qty-minus" onclick="decreaseQty(this)">−</button>
                            <input type="number"
                                   name="Quantity"
                                   class="qty-input"
                                   value="1"
                                   min="1"
                                   max="@product.StockQuantity"
                                   readonly
                                   data-price="@product.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   data-max="@product.StockQuantity" />
                            <button type="button" class="qty-btn qty-plus" onclick="increaseQty(this)">+</button>
                        </div>

                        <button type="submit" class="btn-add-order active">
                            🛍️ Place Order
                        </button>

                        <div class="total-display">
                            Total: <span class="total-amount">@product.Price.ToString("C")</span>
                        </div>
                    </form>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📦</div>
            <h3>No Products Available</h3>
            <p>There are currently no products in stock. Please check back later!</p>
            <a asp-action="MyOrders" class="back-button">
                Back to My Orders
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateTotal(qtyInput) {
            const price = parseFloat(qtyInput.getAttribute('data-price'));
            const quantity = parseInt(qtyInput.value);
            const total = price * quantity;

            // Update hidden total price input
            const form = qtyInput.closest('form');
            const totalInput = form.querySelector('.total-price-input');
            totalInput.value = total.toFixed(2);

            // Update display
            const totalDisplay = form.querySelector('.total-amount');
            totalDisplay.textContent = 'R ' + total.toFixed(2);

            // Debug logging
            console.log('Price:', price, 'Quantity:', quantity, 'Total:', total);
        }

        function increaseQty(button) {
            const qtyInput = button.parentElement.querySelector('.qty-input');
            const currentValue = parseInt(qtyInput.value);
            const max = parseInt(qtyInput.getAttribute('data-max'));

            if (currentValue < max) {
                qtyInput.value = currentValue + 1;
                updateTotal(qtyInput);
            }
        }

        function decreaseQty(button) {
            const qtyInput = button.parentElement.querySelector('.qty-input');
            const currentValue = parseInt(qtyInput.value);

            if (currentValue > 1) {
                qtyInput.value = currentValue - 1;
                updateTotal(qtyInput);
            }
        }

        // Initialize and handle form submissions
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize all quantity inputs with correct totals
            document.querySelectorAll('.qty-input').forEach(input => {
                updateTotal(input);
            });

            // Handle form submissions
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', function(e) {
                    e.preventDefault(); // Prevent immediate submission

                    // Force update the total price one more time before submit
                    const qtyInput = this.querySelector('.qty-input');
                    const totalPriceInput = this.querySelector('.total-price-input');
                    const price = parseFloat(qtyInput.getAttribute('data-price'));
                    const quantity = parseInt(qtyInput.value);
                    const total = price * quantity;

                    // Set the value directly
                    totalPriceInput.value = total.toFixed(2);

                    console.log('=== FINAL SUBMIT ===');
                    console.log('Price:', price, 'Quantity:', quantity, 'Total:', total);
                    console.log('Hidden input value:', totalPriceInput.value);

                    // Verify the value is valid
                    if (!total || total <= 0 || isNaN(total)) {
                        alert('Invalid total price. Please refresh and try again.');
                        return false;
                    }

                    // Log all form data
                    const formData = new FormData(this);
                    console.log('=== FORM DATA ===');
                    for (let [key, value] of formData.entries()) {
                        console.log(key + ':', value);
                    }

                    // Disable button
                    const button = this.querySelector('.btn-add-order');
                    button.disabled = true;
                    button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating Order...';

                    // Now actually submit the form
                    this.submit();
                });
            });
        });

        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}