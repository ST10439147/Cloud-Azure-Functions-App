@{
    ViewData["Title"] = "Queue Status";
    var orderQueueLength = ViewBag.OrderQueueLength ?? 0;
    var inventoryQueueLength = ViewBag.InventoryQueueLength ?? 0;
    var error = ViewBag.Error as string;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">
                        <i class="fas fa-chart-line me-2 text-primary"></i>Queue Status
                    </h2>
                    <p class="text-muted mb-0">Monitor message queue statistics and performance</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" onclick="refreshStatus()">
                        <i class="fas fa-sync-alt me-1"></i>Refresh
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Orders
                    </a>
                </div>
            </div>

            <!-- Error Display -->
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Queue Statistics Cards -->
            <div class="row mb-4">
                <!-- Order Queue Card -->
                <div class="col-md-6 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-primary text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="fas fa-shopping-cart me-2"></i>Order Queue
                                </h5>
                                <span class="badge bg-white text-primary fs-6">ordermsg</span>
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <div class="queue-counter" data-target="@orderQueueLength">
                                    <span class="display-3 fw-bold text-primary">0</span>
                                </div>
                                <p class="text-muted mb-0">Messages in Queue</p>
                            </div>

                            <div class="row text-center">
                                <div class="col-6">
                                    <div class="metric-card">
                                        <i class="fas fa-clock text-warning mb-2"></i>
                                        <div class="metric-label">Status</div>
                                        <div class="metric-value">
                                            @if (orderQueueLength == 0)
                                            {
                                                <span class="badge bg-success">Empty</span>
                                            }
                                            else if (orderQueueLength < 10)
                                            {
                                                <span class="badge bg-warning">Normal</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">High Load</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="metric-card">
                                        <i class="fas fa-tachometer-alt text-info mb-2"></i>
                                        <div class="metric-label">Load Level</div>
                                        <div class="metric-value">
                                            @{
                                                var loadPercentage = Math.Min(100, (orderQueueLength * 10));
                                            }
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar @(loadPercentage < 30 ? "bg-success" : loadPercentage < 70 ? "bg-warning" : "bg-danger")"
                                                     style="width: @(loadPercentage)%"></div>
                                            </div>
                                            <small class="text-muted">@(loadPercentage)%</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 d-flex gap-2 justify-content-center">
                                <a asp-action="ViewQueueMessages" asp-route-queueName="ordermsg"
                                   class="btn btn-primary btn-sm">
                                    <i class="fas fa-eye me-1"></i>View Messages
                                </a>
                                @if (orderQueueLength > 0)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            onclick="confirmClearQueue('ordermsg', 'Order')">
                                        <i class="fas fa-trash-alt me-1"></i>Clear Queue
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Inventory Queue Card -->
                <div class="col-md-6 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-warning text-dark">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="fas fa-boxes me-2"></i>Inventory Queue
                                </h5>
                                <span class="badge bg-dark text-white fs-6">inventory-msg</span>
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <div class="queue-counter" data-target="@inventoryQueueLength">
                                    <span class="display-3 fw-bold text-warning">0</span>
                                </div>
                                <p class="text-muted mb-0">Messages in Queue</p>
                            </div>

                            <div class="row text-center">
                                <div class="col-6">
                                    <div class="metric-card">
                                        <i class="fas fa-clock text-warning mb-2"></i>
                                        <div class="metric-label">Status</div>
                                        <div class="metric-value">
                                            @if (inventoryQueueLength == 0)
                                            {
                                                <span class="badge bg-success">Empty</span>
                                            }
                                            else if (inventoryQueueLength < 10)
                                            {
                                                <span class="badge bg-warning">Normal</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">High Load</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="metric-card">
                                        <i class="fas fa-tachometer-alt text-info mb-2"></i>
                                        <div class="metric-label">Load Level</div>
                                        <div class="metric-value">
                                            @{
                                                var inventoryLoadPercentage = Math.Min(100, (inventoryQueueLength * 10));
                                            }
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar @(inventoryLoadPercentage < 30 ? "bg-success" : inventoryLoadPercentage < 70 ? "bg-warning" : "bg-danger")"
                                                     style="width: @(inventoryLoadPercentage)%"></div>
                                            </div>
                                            <small class="text-muted">@(inventoryLoadPercentage)%</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 d-flex gap-2 justify-content-center">
                                <a asp-action="ViewQueueMessages" asp-route-queueName="inventory-msg"
                                   class="btn btn-warning btn-sm">
                                    <i class="fas fa-eye me-1"></i>View Messages
                                </a>
                                @if (inventoryQueueLength > 0)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            onclick="confirmClearQueue('inventory-msg', 'Inventory')">
                                        <i class="fas fa-trash-alt me-1"></i>Clear Queue
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Queue Health Summary -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-heartbeat me-2 text-success"></i>Queue Health Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center">
                            <div class="health-metric">
                                <i class="fas fa-server fs-2 text-info mb-2"></i>
                                <h6>Total Messages</h6>
                                <span class="badge bg-info fs-6">@(orderQueueLength + inventoryQueueLength)</span>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="health-metric">
                                @{
                                    var overallHealth = (orderQueueLength + inventoryQueueLength) switch
                                    {
                                        0 => ("Excellent", "text-success", "fa-check-circle"),
                                        <= 10 => ("Good", "text-success", "fa-smile"),
                                        <= 20 => ("Fair", "text-warning", "fa-meh"),
                                        _ => ("Poor", "text-danger", "fa-frown")
                                    };
                                }
                                <i class="fas @overallHealth.Item3 fs-2 @overallHealth.Item2 mb-2"></i>
                                <h6>Overall Health</h6>
                                <span class="@overallHealth.Item2 fw-bold">@overallHealth.Item1</span>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="health-metric">
                                <i class="fas fa-clock fs-2 text-primary mb-2"></i>
                                <h6>Last Updated</h6>
                                <span class="text-muted" id="lastUpdated">@DateTime.Now.ToString("HH:mm:ss")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6><i class="fas fa-eye me-2"></i>View Queue Messages</h6>
                            <p class="text-muted small">Inspect individual messages in queues</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="ViewQueueMessages" asp-route-queueName="ordermsg"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-shopping-cart me-1"></i>Order Messages
                                </a>
                                <a asp-action="ViewQueueMessages" asp-route-queueName="inventory-msg"
                                   class="btn btn-outline-warning btn-sm">
                                    <i class="fas fa-boxes me-1"></i>Inventory Messages
                                </a>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fas fa-plus me-2"></i>Create Test Data</h6>
                            <p class="text-muted small">Generate sample orders for testing</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Create" class="btn btn-outline-success btn-sm">
                                    <i class="fas fa-plus me-1"></i>New Order
                                </a>
                                <button type="button" class="btn btn-outline-info btn-sm" onclick="refreshStatus()">
                                    <i class="fas fa-sync-alt me-1"></i>Refresh Status
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .queue-counter span {
        animation: countUp 1.5s ease-out;
    }


    .metric-card {
        padding: 1rem;
        border-radius: 0.5rem;
        background-color: #f8f9fa;
        margin-bottom: 1rem;
    }

    .metric-label {
        font-size: 0.875rem;
        color: #6c757d;
        margin-bottom: 0.25rem;
    }

    .metric-value {
        font-weight: 600;
    }

    .health-metric {
        padding: 1rem;
    }

    .card {
        border-radius: 0.75rem;
        transition: transform 0.2s ease-in-out;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .progress {
        border-radius: 10px;
        margin-bottom: 0.25rem;
    }

    .fs-2 {
        font-size: 2rem !important;
    }

    .fs-6 {
        font-size: 1rem !important;
    }

    
    .btn-sm {
        padding: 0.375rem 0.75rem;
        font-size: 0.875rem;
    }

    }
</style>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <script>
        // Animate counters on page load
        document.addEventListener('DOMContentLoaded', function() {
            const counters = document.querySelectorAll('.queue-counter');

            counters.forEach(counter => {
                const target = parseInt(counter.getAttribute('data-target'));
                const countElement = counter.querySelector('span');
                let current = 0;
                const increment = target / 30; // 30 steps

                const timer = setInterval(() => {
                    current += increment;
                    if (current >= target) {
                        current = target;
                        clearInterval(timer);
                    }
                    countElement.textContent = Math.floor(current);
                }, 50);
            });

            // Update timestamp every second
            setInterval(updateTimestamp, 1000);
        });

        function updateTimestamp() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-US', { hour12: false });
            document.getElementById('lastUpdated').textContent = timeString;
        }

        function refreshStatus() {
            location.reload();
        }

        function confirmClearQueue(queueName, displayName) {
            if (confirm(`Are you sure you want to clear all messages from the ${displayName} queue? This action cannot be undone.`)) {
                // You would need to implement a clear queue action in your controller
                fetch(`/Order/ClearQueue?queueName=${queueName}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert('Failed to clear queue. Please try again.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while clearing the queue.');
                });
            }
        }
    </script>
}