@{
    ViewData["Title"] = "Queue Messages";
    var queueName = ViewBag.QueueName as string ?? "Unknown";
    var messages = ViewBag.Messages as List<string> ?? new List<string>();
    var error = ViewBag.Error as string;

    // Determine queue display properties
    var queueDisplayName = queueName switch
    {
        "ordermsg" => "Order Messages",
        "inventory-msg" => "Inventory Messages",
        _ => $"{queueName} Messages"
    };

    var queueIcon = queueName switch
    {
        "ordermsg" => "fas fa-shopping-cart",
        "inventory-msg" => "fas fa-boxes",
        _ => "fas fa-envelope"
    };

    var queueColor = queueName switch
    {
        "ordermsg" => "primary",
        "inventory-msg" => "warning",
        _ => "secondary"
    };
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">
                        <i class="@queueIcon me-2 text-@queueColor"></i>@queueDisplayName
                    </h2>
                    <p class="text-muted mb-0">
                        Queue: <code>@queueName</code> |
                        Messages: <span class="badge bg-@queueColor">@messages.Count</span> |
                        Last Updated: <span id="lastUpdated">@DateTime.Now.ToString("HH:mm:ss")</span>
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" onclick="refreshMessages()">
                        <i class="fas fa-sync-alt me-1"></i>Refresh
                    </button>
                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-exchange-alt me-1"></i>Switch Queue
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item @(queueName == "ordermsg" ? "active" : "")"
                                   asp-action="ViewQueueMessages" asp-route-queueName="ordermsg">
                                    <i class="fas fa-shopping-cart me-2"></i>Order Messages
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(queueName == "inventory-msg" ? "active" : "")"
                                   asp-action="ViewQueueMessages" asp-route-queueName="inventory-msg">
                                    <i class="fas fa-boxes me-2"></i>Inventory Messages
                                </a>
                            </li>
                        </ul>
                    </div>
                    <a asp-action="QueueStatus" class="btn btn-secondary">
                        <i class="fas fa-chart-line me-1"></i>Queue Status
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Orders
                    </a>
                </div>
            </div>

            <!-- Error Display -->
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Success/Info Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Queue Statistics Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-@queueColor text-white">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="mb-0">
                                <i class="@queueIcon me-2"></i>@queueDisplayName
                            </h5>
                        </div>
                        <div class="col-md-4 text-end">
                            <span class="badge bg-white text-@queueColor fs-6">
                                @messages.Count message@(messages.Count != 1 ? "s" : "")
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (messages.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-inbox fs-1 text-muted mb-3"></i>
                            <h4 class="text-muted">No Messages in Queue</h4>
                            <p class="text-muted">The @queueDisplayName.ToLower() queue is currently empty.</p>
                            <div class="mt-3">
                                @if (queueName == "ordermsg")
                                {
                                    <a asp-action="Create" class="btn btn-primary">
                                        <i class="fas fa-plus me-1"></i>Create New Order
                                    </a>
                                }
                                <button class="btn btn-outline-secondary ms-2" onclick="refreshMessages()">
                                    <i class="fas fa-sync-alt me-1"></i>Refresh
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Bulk Actions -->
                        <div class="row mb-3">
                            <div class="col-md-6 text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-secondary" id="expandAll">
                                        <i class="fas fa-expand-alt me-1"></i>Expand All
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" id="collapseAll">
                                        <i class="fas fa-compress-alt me-1"></i>Collapse All
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Messages List -->
                        <div class="row">
                            @for (int i = 0; i < messages.Count; i++)
                            {
                                var message = messages[i];
                                var messageId = $"message-{i}";

                                // Try to parse as JSON for better formatting
                                var isJsonMessage = message.TrimStart().StartsWith("{");
                                var formattedMessage = message;
                                var messageType = "text";
                                var messageData = new Dictionary<string, object>();

                                if (isJsonMessage)
                                {
                                    try
                                    {
                                        // This is a simple JSON detection - in a real app you might use Newtonsoft.Json
                                        messageType = "json";
                                        // For display purposes
                                        formattedMessage = FormatJsonString(message);
                                    }
                                    catch
                                    {
                                        messageType = "text";
                                    }
                                }

                                <div class="col-12 mb-3">
                                    <div class="card border-start border-@queueColor border-4 message-card">
                                        <div class="card-header bg-light">
                                            <div class="row align-items-center">
                                                <div class="col-auto">
                                                    <input type="checkbox" class="form-check-input message-checkbox"
                                                           data-message-index="@i">
                                                </div>
                                                <div class="col">
                                                    <div class="d-flex align-items-center">
                                                        <h6 class="mb-0 me-3">
                                                            <i class="fas fa-envelope me-2"></i>Message #@(i + 1)
                                                        </h6>
                                                        @if (messageType == "json")
                                                        {
                                                            <span class="badge bg-success me-2">JSON</span>
                                                        }
                                                        @if (queueName == "ordermsg")
                                                        {
                                                            <span class="badge bg-primary">Order Data</span>
                                                        }
                                                        else if (queueName == "inventory-msg")
                                                        {
                                                            <span class="badge bg-warning text-dark">Inventory Update</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="col-auto">
                                                    <button class="btn btn-sm btn-outline-secondary"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#@messageId"
                                                            aria-expanded="false">
                                                        <i class="fas fa-chevron-down"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="collapse" id="@messageId">
                                            <div class="card-body">
                                                @if (messageType == "json")
                                                {
                                                    <!-- JSON Message Display -->
                                                    <div class="mb-3">
                                                        <h6><i class="fas fa-code me-2"></i>Message Content (JSON)</h6>
                                                        <pre class="bg-dark text-light p-3 rounded"><code class="language-json">@formattedMessage</code></pre>
                                                    </div>

                                                    @if (queueName == "ordermsg")
                                                    {
                                                        <!-- Parse and display order data if possible -->
                                                        <div class="mb-3">
                                                            <h6><i class="fas fa-info-circle me-2"></i>Order Information</h6>
                                                            <div class="row">
                                                                <div class="col-md-6">
                                                                    <dl class="row">
                                                                        <dt class="col-sm-4">Order ID:</dt>
                                                                        <dd class="col-sm-8"><span class="extract-json" data-field="orderId">N/A</span></dd>
                                                                        <dt class="col-sm-4">Customer:</dt>
                                                                        <dd class="col-sm-8"><span class="extract-json" data-field="customerId">N/A</span></dd>
                                                                        <dt class="col-sm-4">Product:</dt>
                                                                        <dd class="col-sm-8"><span class="extract-json" data-field="productId">N/A</span></dd>
                                                                    </dl>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <dl class="row">
                                                                        <dt class="col-sm-4">Quantity:</dt>
                                                                        <dd class="col-sm-8"><span class="extract-json" data-field="quantity">N/A</span></dd>
                                                                        <dt class="col-sm-4">Total Price:</dt>
                                                                        <dd class="col-sm-8">R <span class="extract-json" data-field="totalPrice">N/A</span></dd>
                                                                        <dt class="col-sm-4">Action:</dt>
                                                                        <dd class="col-sm-8"><span class="badge bg-info extract-json" data-field="action">N/A</span></dd>
                                                                    </dl>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <!-- Text Message Display -->
                                                    <div class="mb-3">
                                                        <h6><i class="fas fa-file-alt me-2"></i>Message Content</h6>
                                                        <div class="p-3 bg-light rounded border">
                                                            <pre class="mb-0" style="white-space: pre-wrap; word-wrap: break-word;">@message</pre>
                                                        </div>
                                                    </div>

                                                    @if (queueName == "inventory-msg")
                                                    {
                                                        <!-- Parse inventory message information -->
                                                        <div class="mb-3">
                                                            <h6><i class="fas fa-boxes me-2"></i>Inventory Information</h6>
                                                            <div class="alert alert-info">
                                                                <small>
                                                                    <i class="fas fa-info-circle me-1"></i>
                                                                    This appears to be an inventory update message.
                                                                    Check the content above for order ID, product ID, and quantity information.
                                                                </small>
                                                            </div>
                                                        </div>
                                                    }
                                                }

                                                <!-- Message Actions -->
                                                <div class="mt-3 pt-3 border-top">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <small class="text-muted">
                                                                <i class="fas fa-database me-1"></i>Queue: @queueName
                                                            </small>
                                                        </div>
                                                        <div class="btn-group btn-group-sm">
                                                            <button class="btn btn-outline-secondary" onclick="copyMessage(@i)">
                                                                <i class="fas fa-copy me-1"></i>Copy
                                                            </button>
                                                            <form method="post" asp-action="ProcessOrderMessage" class="d-inline">
                                                                <input name="messageId" value="msg-@i" type="hidden">
                                                                <input name="popReceipt" value="receipt-@i" type="hidden">
                                                                <input name="queueName" value="@queueName" type="hidden">
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination (if needed for large message counts) -->
                        @if (messages.Count > 20)
                        {
                            <nav aria-label="Message pagination" class="mt-4">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item disabled">
                                        <span class="page-link">Previous</span>
                                    </li>
                                    <li class="page-item active">
                                        <span class="page-link">1</span>
                                    </li>
                                    <li class="page-item disabled">
                                        <span class="page-link">Next</span>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden textarea for copying messages -->
<textarea id="copyHelper" style="position: fixed; top: -1000px; left: -1000px;"></textarea>

<style>
    .message-card {
        transition: all 0.3s ease;
        margin-bottom: 0.5rem;
    }

        .message-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

    .border-4 {
        border-width: 4px !important;
    }

    pre code {
        font-size: 0.85rem;
        line-height: 1.4;
    }

    .card-header {
        border-radius: 0.75rem 0.75rem 0 0;
    }

    .extract-json {
        font-family: 'Courier New', monospace;
        font-weight: 600;
    }

    .auto-refresh-indicator {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 1050;
    }


    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }

    .card-body {
        padding: 1rem;
    }

    pre {
        font-size: 0.75rem;
        overflow-x: auto;
    }

    }
</style>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <script>
        let autoRefreshInterval;
        let autoRefreshActive = false;

        @{
                    // Create a JavaScript array of messages for client-side processing
                    var jsMessages = System.Text.Json.JsonSerializer.Serialize(messages);
        }

        const messages = @Html.Raw(jsMessages);

        document.addEventListener('DOMContentLoaded', function() {
            // Initialize JSON extraction for order messages
            extractJsonData();

            // Setup checkbox handlers
            setupCheckboxHandlers();

            // Update timestamp
            updateTimestamp();
            setInterval(updateTimestamp, 1000);

            // Setup expand/collapse handlers
            setupExpandCollapseHandlers();
        });

        function extractJsonData() {
            document.querySelectorAll('.extract-json').forEach(element => {
                const field = element.dataset.field;
                const messageCard = element.closest('.message-card');
                const messageIndex = messageCard.querySelector('.message-checkbox').dataset.messageIndex;
                const messageContent = messages[messageIndex];

                try {
                    const jsonData = JSON.parse(messageContent);
                    const value = jsonData[field] || jsonData[field.toLowerCase()] ||
                                  jsonData[field.charAt(0).toUpperCase() + field.slice(1)];

                    if (value !== undefined && value !== null) {
                        element.textContent = value;
                        if (element.classList.contains('badge')) {
                            element.classList.remove('bg-info');
                            element.classList.add('bg-success');
                        }
                    }
                } catch (e) {
                    // Not valid JSON or field not found
                }
            });
        }

        function setupCheckboxHandlers() {
            const selectAll = document.getElementById('selectAll');
            const messageCheckboxes = document.querySelectorAll('.message-checkbox');
            const deleteSelected = document.getElementById('deleteSelected');

            selectAll.addEventListener('change', function() {
                messageCheckboxes.forEach(checkbox => {
                    checkbox.checked = this.checked;
                });
                updateDeleteButton();
            });

            messageCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', updateDeleteButton);
            });

            function updateDeleteButton() {
                const selectedCount = document.querySelectorAll('.message-checkbox:checked').length;
                deleteSelected.disabled = selectedCount === 0;
                deleteSelected.textContent = selectedCount > 0 ?
                    `Delete Selected (${selectedCount})` : 'Delete Selected';
            }
        }

        function setupExpandCollapseHandlers() {
            document.getElementById('expandAll').addEventListener('click', function() {
                document.querySelectorAll('.collapse').forEach(collapse => {
                    if (!collapse.classList.contains('show')) {
                        bootstrap.Collapse.getOrCreateInstance(collapse).show();
                    }
                });
            });

            document.getElementById('collapseAll').addEventListener('click', function() {
                document.querySelectorAll('.collapse.show').forEach(collapse => {
                    bootstrap.Collapse.getOrCreateInstance(collapse).hide();
                });
            });
        }

        function updateTimestamp() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-US', { hour12: false });
            const timestampElement = document.getElementById('lastUpdated');
            if (timestampElement) {
                timestampElement.textContent = timeString;
            }
        }

        function refreshMessages() {
            location.reload();
        }

        function startAutoRefresh() {
            if (!autoRefreshActive) {
                autoRefreshActive = true;
                autoRefreshInterval = setInterval(refreshMessages, 10000); // Refresh every 10 seconds

                // Update button states
                document.querySelector('button[onclick="startAutoRefresh()"]').disabled = true;
                document.querySelector('button[onclick="stopAutoRefresh()"]').disabled = false;

                // Show indicator
                showAutoRefreshIndicator();
            }
        }

        function stopAutoRefresh() {
            if (autoRefreshActive) {
                autoRefreshActive = false;
                clearInterval(autoRefreshInterval);

                // Update button states
                document.querySelector('button[onclick="startAutoRefresh()"]').disabled = false;
                document.querySelector('button[onclick="stopAutoRefresh()"]').disabled = true;

                // Hide indicator
                hideAutoRefreshIndicator();
            }
        }

        function showAutoRefreshIndicator() {
            const indicator = document.createElement('div');
            indicator.id = 'autoRefreshIndicator';
            indicator.className = 'auto-refresh-indicator alert alert-info alert-dismissible fade show';
            indicator.innerHTML = `
                <i class="fas fa-sync-alt fa-spin me-2"></i>Auto-refresh enabled (10s)
                <button type="button" class="btn-close" onclick="stopAutoRefresh()"></button>
            `;
            document.body.appendChild(indicator);
        }

        function hideAutoRefreshIndicator() {
            const indicator = document.getElementById('autoRefreshIndicator');
            if (indicator) {
                indicator.remove();
            }
        }

        function copyMessage(index) {
            const message = messages[index];
            const copyHelper = document.getElementById('copyHelper');
            copyHelper.value = message;
            copyHelper.select();
            document.execCommand('copy');

            // Show success feedback
            const btn = event.target.closest('button');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check me-1"></i>Copied!';
            btn.classList.add('btn-success');
            btn.classList.remove('btn-outline-secondary');

            setTimeout(() => {
                btn.innerHTML = originalText;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-secondary');
            }, 2000);
        }

        function exportMessage(index) {
            const message = messages[index];
            const blob = new Blob([message], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `message-${index + 1}-${new Date().getTime()}.txt`;
            a.click();
            URL.revokeObjectURL(url);
        }

        function exportAllMessages(format) {
            let content = '';
            let filename = '';
            let mimeType = '';

            switch (format) {
                case 'json':
                    content = JSON.stringify(messages, null, 2);
                    filename = `queue-messages-${new Date().getTime()}.json`;
                    mimeType = 'application/json';
                    break;
                case 'csv':
                    content = 'Index,Message,Length\n';
                    messages.forEach((msg, index) => {
                        content += `${index + 1},"${msg.replace(/"/g, '""')}",${msg.length}\n`;
                    });
                    filename = `queue-messages-${new Date().getTime()}.csv`;
                    mimeType = 'text/csv';
                    break;
                case 'txt':
                    content = messages.map((msg, index) =>
                        `=== Message ${index + 1} ===\n${msg}\n`
                    ).join('\n');
                    filename = `queue-messages-${new Date().getTime()}.txt`;
                    mimeType = 'text/plain';
                    break;
            }

            const blob = new Blob([content], { type: mimeType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            a.click();
            URL.revokeObjectURL(url);
        }

        // Cleanup on page unload
        window.addEventListener('beforeunload', function() {
            if (autoRefreshActive) {
                stopAutoRefresh();
            }
        });
    </script>
}

@functions {
    private static string FormatJsonString(string json)
    {
        try
        {
            // Simple JSON formatting for display
            return System.Text.Json.JsonSerializer.Serialize(
                System.Text.Json.JsonSerializer.Deserialize<object>(json),
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true }
            );
        }
        catch
        {
            return json;
        }
    }
}