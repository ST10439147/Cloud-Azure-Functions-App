@{
    ViewData["Title"] = "Queue Messages";
    var queueName = ViewBag.QueueName as string ?? "Unknown";
    var isReadOnly = ViewBag.IsReadOnly ?? false;
    var messageCount = ViewBag.MessageCount ?? 0;
    var error = ViewBag.Error as string;

    // Check if we have QueueMessageInfo objects or strings
    var messageInfoList = ViewBag.Messages as List<ST10439147_CLDV6212_POE.Services.QueueMessageInfo>;
    var messageStrings = ViewBag.Messages as List<string>;

    // Determine queue display properties
    var queueDisplayName = queueName switch
    {
        "ordermsg" => "Order Messages",
        "inventory-msg" => "Inventory Messages",
        _ => $"{queueName} Messages"
    };

    var queueIcon = queueName switch
    {
        "ordermsg" => "fas fa-shopping-cart",
        "inventory-msg" => "fas fa-boxes",
        _ => "fas fa-envelope"
    };

    var queueColor = queueName switch
    {
        "ordermsg" => "primary",
        "inventory-msg" => "warning",
        _ => "secondary"
    };
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">
                        <i class="@queueIcon me-2 text-@queueColor"></i>@queueDisplayName
                    </h2>
                    <p class="text-muted mb-0">
                        Queue: <code>@queueName</code> |
                        Messages: <span class="badge bg-@queueColor">@messageCount</span> |
                        Mode: <span class="badge bg-info">@(isReadOnly ? "Peek (Read-Only)" : "Receive")</span> |
                        Last Updated: <span id="lastUpdated">@DateTime.Now.ToString("HH:mm:ss")</span>
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" onclick="refreshMessages()">
                        <i class="fas fa-sync-alt me-1"></i>Refresh
                    </button>
                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-exchange-alt me-1"></i>Switch Queue
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item @(queueName == "ordermsg-poison" ? "active" : "")"
                                   asp-action="ViewQueueMessages" asp-route-queueName="ordermsg" asp-route-peek="true">
                                    <i class="fas fa-shopping-cart me-2"></i>Order Messages
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item @(queueName == "inventory-msg-poison" ? "active" : "")"
                                   asp-action="ViewQueueMessages" asp-route-queueName="inventory-msg" asp-route-peek="true">
                                    <i class="fas fa-boxes me-2"></i>Inventory Messages
                                </a>
                            </li>
                        </ul>
                    </div>
                    <a asp-action="QueueStatus" class="btn btn-secondary">
                        <i class="fas fa-chart-line me-1"></i>Queue Status
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Orders
                    </a>
                </div>
            </div>

            <!-- Error Display -->
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Success/Info Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Queue Statistics Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-@queueColor text-white">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="mb-0">
                                <i class="@queueIcon me-2"></i>@queueDisplayName
                            </h5>
                        </div>
                        <div class="col-md-4 text-end">
                            <span class="badge bg-white text-@queueColor fs-6">
                                @messageCount message@(messageCount != 1 ? "s" : "")
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (messageCount == 0)
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-inbox fs-1 text-muted mb-3"></i>
                            <h4 class="text-muted">No Messages in Queue</h4>
                            <p class="text-muted">The @queueDisplayName.ToLower() queue is currently empty.</p>
                            <div class="mt-3">
                                @if (queueName == "ordermsg")
                                {
                                    <a asp-action="Create" class="btn btn-primary">
                                        <i class="fas fa-plus me-1"></i>Create New Order
                                    </a>
                                }
                                <button class="btn btn-outline-secondary ms-2" onclick="refreshMessages()">
                                    <i class="fas fa-sync-alt me-1"></i>Refresh
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Messages List -->
                        <div class="row">
                            @if (messageInfoList != null)
                            {
                                @* Receive mode - full message info *@
                                @for (int i = 0; i < messageInfoList.Count; i++)
                                {
                                    var msg = messageInfoList[i];
                                    var messageId = $"message-{i}";
                                    var isJsonMessage = msg.MessageText.TrimStart().StartsWith("{");

                                    <div class="col-12 mb-3">
                                        <div class="card border-start border-@queueColor border-4 message-card">
                                            <div class="card-header bg-light">
                                                <div class="row align-items-center">
                                                    <div class="col">
                                                        <div class="d-flex align-items-center">
                                                            <h6 class="mb-0 me-3">
                                                                <i class="fas fa-envelope me-2"></i>Message #@(i + 1)
                                                            </h6>
                                                            @if (isJsonMessage)
                                                            {
                                                                <span class="badge bg-success">JSON</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">Text</span>
                                                            }
                                                        </div>
                                                        <small class="text-muted">
                                                            Dequeue Count: @msg.DequeueCount |
                                                            Inserted: @msg.InsertedOn?.ToString("g")
                                                        </small>
                                                    </div>
                                                    <div class="col-auto">
                                                        <button class="btn btn-sm btn-outline-secondary"
                                                                type="button"
                                                                data-bs-toggle="collapse"
                                                                data-bs-target="#@messageId"
                                                                aria-expanded="false">
                                                            <i class="fas fa-chevron-down"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="collapse show" id="@messageId">
                                                <div class="card-body">
                                                    <!-- Message Content -->
                                                    <div class="mb-3">
                                                        <h6><i class="fas fa-file-alt me-2"></i>Message Content</h6>
                                                        <div class="p-3 bg-light rounded border">
                                                            @if (isJsonMessage)
                                                            {
                                                                <pre class="mb-0" style="white-space: pre-wrap; word-wrap: break-word; font-size: 0.85rem;">@msg.MessageText</pre>
                                                            }
                                                            else
                                                            {
                                                                <div style="font-family: monospace; font-size: 0.9rem;">@msg.MessageText</div>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- Actions -->
                                                    <div class="mt-3 pt-3 border-top">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <small class="text-muted">
                                                                    <i class="fas fa-database me-1"></i>Message ID: <code>@msg.MessageId</code>
                                                                </small>
                                                            </div>
                                                            <div class="btn-group btn-group-sm">
                                                                <button class="btn btn-outline-secondary" onclick='copyMessageText(@i, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(msg.MessageText)))'>
                                                                    <i class="fas fa-copy me-1"></i>Copy
                                                                </button>
                                                                <form method="post" asp-action="ProcessOrderMessage" class="d-inline">
                                                                    <input name="messageId" value="@msg.MessageId" type="hidden">
                                                                    <input name="popReceipt" value="@msg.PopReceipt" type="hidden">
                                                                    <input name="queueName" value="@queueName" type="hidden">
                                                                    <button type="submit" class="btn btn-danger btn-sm">
                                                                        <i class="fas fa-trash me-1"></i>Delete
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else if (messageStrings != null)
                            {
                                @* Peek mode - string messages only *@
                                @for (int i = 0; i < messageStrings.Count; i++)
                                {
                                    var message = messageStrings[i];
                                    var messageId = $"message-{i}";
                                    var isJsonMessage = message.TrimStart().StartsWith("{");

                                    <div class="col-12 mb-3">
                                        <div class="card border-start border-@queueColor border-4 message-card">
                                            <div class="card-header bg-light">
                                                <div class="row align-items-center">
                                                    <div class="col">
                                                        <div class="d-flex align-items-center">
                                                            <h6 class="mb-0 me-3">
                                                                <i class="fas fa-eye me-2"></i>Message #@(i + 1)
                                                            </h6>
                                                            @if (isJsonMessage)
                                                            {
                                                                <span class="badge bg-success">JSON</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">Text</span>
                                                            }
                                                            <span class="badge bg-info ms-2">Peek Mode</span>
                                                        </div>
                                                    </div>
                                                    <div class="col-auto">
                                                        <button class="btn btn-sm btn-outline-secondary"
                                                                type="button"
                                                                data-bs-toggle="collapse"
                                                                data-bs-target="#@messageId"
                                                                aria-expanded="false">
                                                            <i class="fas fa-chevron-down"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="collapse show" id="@messageId">
                                                <div class="card-body">
                                                    <!-- Message Content -->
                                                    <div class="mb-3">
                                                        <h6><i class="fas fa-file-alt me-2"></i>Message Content</h6>
                                                        <div class="p-3 bg-light rounded border">
                                                            @if (isJsonMessage)
                                                            {
                                                                <pre class="mb-0" style="white-space: pre-wrap; word-wrap: break-word; font-size: 0.85rem;">@message</pre>
                                                            }
                                                            else
                                                            {
                                                                <div style="font-family: monospace; font-size: 0.9rem;">@message</div>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- Actions -->
                                                    <div class="mt-3 pt-3 border-top">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <small class="text-muted">
                                                                    <i class="fas fa-info-circle me-1"></i>Read-only preview (no deletion available)
                                                                </small>
                                                            </div>
                                                            <div class="btn-group btn-group-sm">
                                                                <button class="btn btn-outline-secondary" onclick='copyMessageText(@i, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(message)))'>
                                                                    <i class="fas fa-copy me-1"></i>Copy
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .message-card {
        transition: all 0.3s ease;
    }

        .message-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

    .border-4 {
        border-width: 4px !important;
    }

    pre {
        font-size: 0.75rem;
        overflow-x: auto;
        max-height: 400px;
        margin-bottom: 0;
    }

    code {
        font-size: 0.85rem;
    }
</style>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <script>
        function updateTimestamp() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-US', { hour12: false });
            const timestampElement = document.getElementById('lastUpdated');
            if (timestampElement) {
                timestampElement.textContent = timeString;
            }
        }

        function refreshMessages() {
            location.reload();
        }

        function copyMessageText(index, messageText) {
            const textarea = document.createElement('textarea');
            textarea.value = messageText;
            textarea.style.position = 'fixed';
            textarea.style.top = '-1000px';
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);

            // Show feedback
            const btn = event.target.closest('button');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check me-1"></i>Copied!';
            btn.classList.add('btn-success');
            btn.classList.remove('btn-outline-secondary');

            setTimeout(() => {
                btn.innerHTML = originalHtml;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-secondary');
            }, 2000);
        }

        // Update timestamp every second
        document.addEventListener('DOMContentLoaded', function() {
            updateTimestamp();
            setInterval(updateTimestamp, 1000);
        });
    </script>
}