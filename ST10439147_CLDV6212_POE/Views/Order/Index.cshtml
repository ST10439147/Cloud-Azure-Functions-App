<!-- Views/Order/Index.cshtml -->
@model IEnumerable<ST10439147_CLDV6212_POE.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Orders</h2>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Create New Order
                </a>
            </div>

            @if (Model.Any())
            {
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Customer</th>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th>Total Price</th>
                                        <th>Order Date</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model)
                                    {
                                        <tr>
                                            <td><small class="text-muted">@order.RowKey.Substring(0, 8)...</small></td>
                                            <td>@order.CustomerId</td>
                                            <td>@order.ProductId</td>
                                            <td>@order.Quantity</td>
                                            <td>$@order.TotalPrice.ToString("F2")</td>
                                            <td>@order.OrderDate.ToString("MM/dd/yyyy")</td>
                                            <td>
                                                <span class="badge @(order.Status switch {
                                                    "Pending" => "bg-warning",
                                                    "Shipped" => "bg-info",
                                                    "Completed" => "bg-success",
                                                    _ => "bg-secondary"
                                                })">
                                                    @order.Status
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="#" class="btn btn-sm btn-outline-primary">
                                                        <i class="fas fa-eye"></i> View
                                                    </a>
                                                    <a href="#" class="btn btn-sm btn-outline-secondary">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <h4>No orders found</h4>
                    <p>Orders will appear here once customers start placing them.</p>
                    <a asp-action="Create" class="btn btn-primary">Create Order</a>
                </div>
            }
        </div>
    </div>
</div>