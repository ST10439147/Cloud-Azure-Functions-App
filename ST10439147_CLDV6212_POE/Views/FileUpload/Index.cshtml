@model IEnumerable<ST10439147_CLDV6212_POE.Models.FileUpload>

@{
    ViewData["Title"] = "File Management";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-file-alt me-2"></i>File Management</h2>
                <a asp-action="Upload" class="btn btn-primary">
                    <i class="fas fa-upload me-2"></i>Upload New File
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-folder-open me-2"></i>Uploaded Files
                            <span class="badge bg-secondary ms-2">@Model.Count() files</span>
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th><i class="fas fa-file me-1"></i>File Name</th>
                                        <th><i class="fas fa-tag me-1"></i>Type</th>
                                        <th><i class="fas fa-weight-hanging me-1"></i>Size</th>
                                        <th><i class="fas fa-user me-1"></i>Uploaded By</th>
                                        <th><i class="fas fa-calendar me-1"></i>Upload Date</th>
                                        <th><i class="fas fa-cogs me-1"></i>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @{
                                                        string iconClass = "fas fa-file";
                                                        string badgeClass = "bg-secondary";

                                                        switch (file.FileType?.ToLower())
                                                        {
                                                            case "pdf":
                                                                iconClass = "fas fa-file-pdf text-danger";
                                                                badgeClass = "bg-danger";
                                                                break;
                                                            case "docx":
                                                            case "doc":
                                                                iconClass = "fas fa-file-word text-primary";
                                                                badgeClass = "bg-primary";
                                                                break;
                                                            case "xlsx":
                                                            case "xls":
                                                                iconClass = "fas fa-file-excel text-success";
                                                                badgeClass = "bg-success";
                                                                break;
                                                            case "jpg":
                                                            case "jpeg":
                                                            case "png":
                                                            case "gif":
                                                                iconClass = "fas fa-file-image text-info";
                                                                badgeClass = "bg-info";
                                                                break;
                                                            case "txt":
                                                                iconClass = "fas fa-file-alt text-secondary";
                                                                break;
                                                        }
                                                    }
                                                    <i class="@iconClass me-2"></i>
                                                    <span class="fw-medium">@file.FileName</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @badgeClass">@file.FileType?.ToUpper()</span>
                                            </td>
                                            <td>
                                                @{
                                                    string sizeDisplay = "";
                                                    if (file.FileSize < 1024)
                                                        sizeDisplay = $"{file.FileSize} B";
                                                    else if (file.FileSize < 1024 * 1024)
                                                        sizeDisplay = $"{file.FileSize / 1024:F1} KB";
                                                    else if (file.FileSize < 1024 * 1024 * 1024)
                                                        sizeDisplay = $"{file.FileSize / (1024 * 1024):F1} MB";
                                                    else
                                                        sizeDisplay = $"{file.FileSize / (1024 * 1024 * 1024):F1} GB";
                                                }
                                                <span class="text-muted">@sizeDisplay</span>
                                            </td>
                                            <td>
                                                <i class="fas fa-user-circle me-1 text-muted"></i>
                                                @file.UploadedBy
                                            </td>
                                            <td>
                                                <span class="text-muted">
                                                    @file.UploadedOn.ToString("MMM dd, yyyy")
                                                    <small class="d-block text-muted">
                                                        @file.UploadedOn.ToString("HH:mm")
                                                    </small>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Download"
                                                       asp-route-fileName="@file.FileName"
                                                       class="btn btn-sm btn-outline-primary"
                                                       title="Download file">
                                                        <i class="fas fa-download"></i>
                                                    </a>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-info"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#fileInfoModal"
                                                            data-file-name="@file.FileName"
                                                            data-file-type="@file.FileType"
                                                            data-file-size="@sizeDisplay"
                                                            data-uploaded-by="@file.UploadedBy"
                                                            data-uploaded-on="@file.UploadedOn.ToString("MMMM dd, yyyy 'at' HH:mm")"
                                                            title="View file details">
                                                        <i class="fas fa-info-circle"></i>
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteConfirmModal"
                                                            data-file-name="@file.FileName"
                                                            title="Delete file">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-folder-open fa-4x text-muted"></i>
                    </div>
                    <h4 class="text-muted">No Files Found</h4>
                    <p class="text-muted mb-4">Start by uploading your first file to the system.</p>
                    <a asp-action="Upload" class="btn btn-primary">
                        <i class="fas fa-upload me-2"></i>Upload Your First File
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- File Info Modal -->
<div class="modal fade" id="fileInfoModal" tabindex="-1" aria-labelledby="fileInfoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="fileInfoModalLabel">
                    <i class="fas fa-info-circle me-2"></i>File Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <dl class="row">
                    <dt class="col-sm-4">File Name:</dt>
                    <dd class="col-sm-8" id="modalFileName"></dd>

                    <dt class="col-sm-4">File Type:</dt>
                    <dd class="col-sm-8" id="modalFileType"></dd>

                    <dt class="col-sm-4">File Size:</dt>
                    <dd class="col-sm-8" id="modalFileSize"></dd>

                    <dt class="col-sm-4">Uploaded By:</dt>
                    <dd class="col-sm-8" id="modalUploadedBy"></dd>

                    <dt class="col-sm-4">Upload Date:</dt>
                    <dd class="col-sm-8" id="modalUploadedOn"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteConfirmModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center mb-3">
                    <i class="fas fa-trash-alt fa-2x text-danger me-3"></i>
                    <div>
                        <h6 class="mb-1">Are you sure you want to delete this file?</h6>
                        <p class="text-muted mb-0">This action cannot be undone.</p>
                    </div>
                </div>
                <div class="bg-light p-3 rounded">
                    <strong>File Name:</strong> <span id="deleteFileName"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <a id="confirmDeleteBtn" href="#" class="btn btn-danger">
                    <i class="fas fa-trash-alt me-1"></i>Delete File
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    // Handle file info modal
    document.addEventListener('DOMContentLoaded', function() {
        const fileInfoModal = document.getElementById('fileInfoModal');
        if (fileInfoModal) {
            fileInfoModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;

                document.getElementById('modalFileName').textContent = button.getAttribute('data-file-name');
                document.getElementById('modalFileType').textContent = button.getAttribute('data-file-type');
                document.getElementById('modalFileSize').textContent = button.getAttribute('data-file-size');
                document.getElementById('modalUploadedBy').textContent = button.getAttribute('data-uploaded-by');
                document.getElementById('modalUploadedOn').textContent = button.getAttribute('data-uploaded-on');
            });
        }

        // Handle delete confirmation modal
        const deleteConfirmModal = document.getElementById('deleteConfirmModal');
        if (deleteConfirmModal) {
            deleteConfirmModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const fileName = button.getAttribute('data-file-name');

                document.getElementById('deleteFileName').textContent = fileName;

                // Update the delete button link
                const confirmBtn = document.getElementById('confirmDeleteBtn');
                confirmBtn.href = `/FileUpload/Delete?fileName=${encodeURIComponent(fileName)}`;
            });
        }
    });
</script>