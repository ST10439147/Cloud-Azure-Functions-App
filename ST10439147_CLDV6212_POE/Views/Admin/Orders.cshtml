@model List<ST10439147_CLDV6212_POE.Models.Order>
@{
    ViewData["Title"] = "Manage Orders";
    var customers = ViewBag.Customers as Dictionary<string, ST10439147_CLDV6212_POE.Models.Customer>;
    var products = ViewBag.Products as Dictionary<string, ST10439147_CLDV6212_POE.Models.Product>;
}

<div class="container mt-4">
    <h2>Manage Orders</h2>

    <!-- Filter buttons -->
    <div class="mb-3">
        <a asp-action="Orders" class="btn btn-outline-primary @(string.IsNullOrEmpty(ViewBag.StatusFilter) ? "active" : "")">All</a>
        <a asp-action="Orders" asp-route-status="Pending" class="btn btn-outline-warning @(ViewBag.StatusFilter == "Pending" ? "active" : "")">Pending</a>
        <a asp-action="Orders" asp-route-status="PROCESSED" class="btn btn-outline-success @(ViewBag.StatusFilter == "PROCESSED" ? "active" : "")">Processed</a>
    </div>

    @if (Model.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Total Price</th>
                    <th>Order Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    var customer = customers?.GetValueOrDefault(order.CustomerId);
                    var product = products?.GetValueOrDefault(order.ProductId);

                    <tr>
                        <td>@order.RowKey.Substring(0, 8)...</td>
                        <td>@(customer != null ? $"{customer.FirstName} {customer.LastName}" : "Unknown")</td>
                        <td>@(product?.Name ?? "Unknown Product")</td>
                        <td>@order.Quantity</td>
                        <td>@order.TotalPrice.ToString("C")</td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (order.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (order.Status == "PROCESSED")
                            {
                                <span class="badge bg-success">Processed</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@order.Status</span>
                            }
                        </td>
                        <td>
                            <a asp-action="OrderDetails" asp-route-partitionKey="@order.PartitionKey" asp-route-rowKey="@order.RowKey" class="btn btn-sm btn-info">Details</a>

                            @if (order.Status == "Pending")
                            {
                                <form asp-action="ProcessOrder" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="partitionKey" value="@order.PartitionKey" />
                                    <input type="hidden" name="rowKey" value="@order.RowKey" />
                                    <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Mark this order as PROCESSED?')">Process</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            <p>No orders found @(string.IsNullOrEmpty(ViewBag.StatusFilter) ? "" : $"with status '{ViewBag.StatusFilter}'")</p>
        </div>
    }

    <a asp-action="Index" class="btn btn-secondary mt-3">Back to Dashboard</a>
</div>