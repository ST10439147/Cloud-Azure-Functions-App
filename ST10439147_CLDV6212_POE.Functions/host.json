{
  "version": "2.0",
  "extensions": {
    "queues": {
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:00:30",
      "batchSize": 1,
      "maxPollingInterval": "00:00:02",
      "newBatchThreshold": 0,
      "messageEncoding": "none"
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Host.Results": "Warning",
      "Function": "Information",
      "Host.Aggregator": "Warning",
      "Azure.Core": "Warning",
      "Azure.Storage.Queues": "Warning"
    }
  }
}